# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/c2c

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# How many reverse proxies sit between the client and this process. Used to pick the
# right entry out of X-Forwarded-For. Defaults to 0 (no proxy trusted), which is not a
# neutral choice: at 0 every IP-keyed rate limit (login, register, refresh, OAuth) is
# skipped entirely rather than falling back to a shared bucket, because the header
# cannot be trusted without a known proxy count. Railway puts the app behind exactly
# one proxy, so production needs 1.
# TRUSTED_PROXY_HOPS=0

# ─── Storage (listing photos) ──────────────────────────────────────────────────
# "local" writes to STORAGE_DIR on disk; a future "s3" driver is a drop-in.
# Unset defaults to "memory" under NODE_ENV=test and "local" everywhere else.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=local. `/app/uploads` (what the compose files set) is a
# container path a normal user cannot create on Linux or macOS — the default here is a
# plain relative directory so a first upload works right after `cp .env.example`. Compose
# overrides this to the mounted uploads_data volume; nothing else needs to change.
STORAGE_DIR=./.uploads

# ─── AI: language model (C2C-AI-1) ────────────────────────────────────────────
# "groq" calls the real API; "mock" is deterministic and offline.
# Unset defaults to "mock" under NODE_ENV=test and "groq" everywhere else.
LLM_PROVIDER=mock

# Free key from https://console.groq.com/keys — required when LLM_PROVIDER=groq.
# Missing or blank makes the provider throw at construction; it never falls back
# to the mock, so a misconfigured deployment fails loudly instead of quietly
# serving fake descriptions.
GROQ_API_KEY=gsk_replace_me

# Open-weights model on Groq's OpenAI-compatible endpoint.
GROQ_MODEL=qwen/qwen3.8-27b

# Upper bound on a single completion, in milliseconds. Bounds a hung request
# holding a route handler open; it is a ceiling, not a target.
LLM_TIMEOUT_MS=15000

# ─── AI: embeddings (C2C-AI-2) ────────────────────────────────────────────────
# "local" runs Xenova/all-MiniLM-L6-v2 in-process via Transformers.js; "mock"
# produces deterministic pseudo-vectors of the same width with no model at all.
# Unset defaults to "mock" under NODE_ENV=test and "local" everywhere else.
EMBEDDING_PROVIDER=local

# Where model files live. Transformers.js otherwise caches inside node_modules,
# which a multi-stage Docker build discards. Set in the Dockerfile so the model
# baked at build time survives into the runtime image; leave unset locally.
# TRANSFORMERS_CACHE=/app/.cache/transformers

# ─── OAuth2 (C2C-SEC-6) ───────────────────────────────────────────────────────
# Set OAUTH_PROVIDER=mock to exercise the whole flow offline with no credentials
# at all; leave it unset to use the real providers. A provider whose id OR secret
# is missing is absent from the registry entirely, so its button does not render
# and its route answers 404 rather than redirecting somewhere broken.
# OAUTH_PROVIDER=mock

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps.
# Authorisation callback URL: <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/github/callback
# Note: GitHub OAuth Apps do not support PKCE, so this flow relies on `state`
# plus the client secret. Google gets PKCE as well.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin of this app, used to build the callback URL. Taken from config
# rather than the request's Host header, which an attacker can set.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Public origin used for absolute URLs in sitemap.xml and robots.txt. Optional:
# falls back to OAUTH_REDIRECT_BASE_URL, which already holds the same value. Set this
# only if the crawler-facing origin genuinely differs from the OAuth callback origin.
# SITE_URL=https://c2c.example
